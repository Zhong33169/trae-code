{
  "name": "exhibitor-qwik",
  "version": "1.0.0",
  "description": "Exhibitor Application Management - Qwik City",
  "scripts": {
    "dev": "vite --mode ssr --port 3002 --host",
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "vite build -c adapters/static/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "preview": "qwik build preview && vite preview --port 3002",
    "start": "node server/entry.express.js"
  },
  "devDependencies": {
    "@builder.io/qwik": "1.20.0",
    "@builder.io/qwik-city": "1.20.0",
    "@types/node": "^20.0.0",
    "ignore": "^7.0.5",
    "typescript": "~5.5.0",
    "vite": "^5.4.0",
    "vite-tsconfig-paths": "^4.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
