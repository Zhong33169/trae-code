---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title?: string;
  currentPage?: string;
}

const { title = '三甲医院医务部 - 异常申诉复核会诊申请单系统', currentPage = 'dashboard' } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
</head>
<body>
  <div class="app-layout">
    <Header />
    <div class="app-body">
      <Sidebar currentPage={currentPage} />
      <main class="app-main">
        <slot />
      </main>
    </div>
  </div>
</body>
</html>
